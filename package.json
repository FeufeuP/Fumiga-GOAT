{
  "name": "fumiga-goat",
  "private": true,
  "description": "FUMIGA — Colônia Eterna. Jogo em JavaScript puro com testes, versão web e instaladores nativos offline completos.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node game/test/run-all.mjs",
    "test:quick": "node game/test/run-all.mjs --quick",
    "inspect": "node game/test/inspect.mjs",
    "inspect:tree": "node game/test/tree-browser.mjs && node game/test/tree-art-browser.mjs",
    "inspect:ui": "node game/test/ui-navigation-browser.mjs",
    "inspect:hud": "node game/test/lorehud-browser.mjs",
    "inspect:layout": "node game/test/layout-browser.mjs",
    "inspect:pwa": "node game/test/pwa-browser.mjs",
    "playtest": "node tools/playtest.mjs",
    "serve": "node game/test/lib/server.mjs 8000",
    "setup": "bash tools/setup-dev.sh",
    "prepare:native": "node tools/sync-native-assets.mjs",
    "package:android": "bash tools/build-android.sh",
    "package:windows": "npm --prefix installers/windows run dist:win"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
